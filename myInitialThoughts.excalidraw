      "version": 276,
      "versionNonce": 1698633088,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789488253742,
      "created": 1789488129457,
      "link": null,
      "locked": false,
      "text": "4. Delete concurrency issue :- again it should be enforced to the first\ncome basis, and handled at backend level so that the not found id \nissue not breaks my backend.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Delete concurrency issue :- again it should be enforced to the first\ncome basis, and handled at backend level so that the not found id \nissue not breaks my backend.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
