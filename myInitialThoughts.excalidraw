    {
      "id": "WjF7aniNJRPA9ZdesNgi2",
      "type": "text",
      "x": -699,
      "y": 302.5,
      "width": 684.6395263671875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
